          "title": "State",
          "type": "string"
        },
        "state_observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Observed At"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "id",
        "name",
        "from_room_id",
        "to_room_id",
        "segment_xy_m",
        "width_m",
        "provenance"
      ],
      "title": "Portal",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
