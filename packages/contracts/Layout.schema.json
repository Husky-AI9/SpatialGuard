{
  "$defs": {
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "floor_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Floor Id",
          "type": "string"
        },
        "position_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 10000.0,
              "minimum": -10000.0,
              "type": "number"
            },
            {
              "maximum": 10000.0,
              "minimum": -10000.0,
              "type": "number"
            },
            {
              "maximum": 100.0,
              "minimum": -100.0,
              "type": "number"
            }
          ],
          "title": "Position M",
          "type": "array"
        },
        "heading_degrees": {
          "default": 0,
          "title": "Heading Degrees",
          "type": "number"
        },
        "pitch_degrees": {
          "default": 0,
          "maximum": 89.0,
          "minimum": -89.0,
          "title": "Pitch Degrees",
          "type": "number"
        },
        "fov_degrees": {
          "default": 70,
          "exclusiveMaximum": 180.0,
          "exclusiveMinimum": 0.0,
          "title": "Fov Degrees",
          "type": "number"
        },
        "range_m": {
          "default": 4,
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Range M",
          "type": "number"
        },
        "configuration_hash": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Configuration Hash",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "id",
        "name",
        "floor_id",
        "position_m",
        "configuration_hash",
        "provenance"
      ],
      "title": "Camera",
      "type": "object"
    },
    "Floor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "elevation_m": {
          "default": 0,
          "title": "Elevation M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Floor",
      "type": "object"
    },
    "FloorPlanImage": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Asset Id",
          "type": "string"
        },
        "origin_xy_m": {
          "default": [
            0,
            0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 10000.0,
              "minimum": -10000.0,
              "type": "number"
            },
            {
              "maximum": 10000.0,
              "minimum": -10000.0,
              "type": "number"
            }
          ],
          "title": "Origin Xy M",
          "type": "array"
        },
        "width_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 10000.0,
          "title": "Width M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 10000.0,
          "title": "Height M",
          "type": "number"
        }
      },
      "required": [
        "asset_id",
        "width_m",
        "height_m"
      ],
      "title": "FloorPlanImage",
      "type": "object"
    },
    "Portal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
