        "to_room_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "To Room Id",
          "type": "string"
        },
        "segment_xy_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 10000.0,
                  "minimum": -10000.0,
                  "type": "number"
                },
                {
                  "maximum": 10000.0,
                  "minimum": -10000.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 10000.0,
                  "minimum": -10000.0,
                  "type": "number"
                },
                {
                  "maximum": 10000.0,
                  "minimum": -10000.0,
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Segment Xy M",
          "type": "array"
        },
        "width_m": {
          "exclusiveMinimum": 0.0,
          "maximum": 20.0,
          "title": "Width M",
          "type": "number"
        },
        "state": {
          "default": "unknown",
          "enum": [
            "open",
            "closed",
            "unknown"
