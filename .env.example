OPENAI_API_KEY=
TWINFORGE_VISION_MODEL=gpt-5.6-sol
SPATIALGUARD_CLASSIFIER_MODEL=gpt-5.6-luna

# Hosted deployment (Railway supplies DATABASE_URL and PORT).
DATABASE_URL=
SPATIALGUARD_TWINFORGE_URL=http://127.0.0.1:8000
SPATIALGUARD_TWINFORGE_TOKEN=
SPATIALGUARD_ALLOWED_ORIGINS=http://127.0.0.1:8010
SPATIALGUARD_ALLOWED_HOSTS=
SPATIALGUARD_ORIGIN=
# Optional hackathon test login. The built-in account is isolated from every other owner.
SPATIALGUARD_ENABLE_TEST_ACCOUNT=false
# A URL-safe Fernet key used only to encrypt stored Ring OAuth tokens on Linux.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPATIALGUARD_TOKEN_KEY=

# Android release build only; never use the local debug endpoint in release.
SPATIALGUARD_API_URL=

# Ring private-app credentials. Keep values in Railway Variables or local .env.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_WEBHOOK_SECRET=
RING_REDIRECT_URI=

# Optional Cam Uptime email delivery. Browser alerts need no server credentials.
SPATIALGUARD_SMTP_HOST=
SPATIALGUARD_SMTP_PORT=587
SPATIALGUARD_SMTP_FROM=
SPATIALGUARD_SMTP_USER=
SPATIALGUARD_SMTP_PASSWORD=
