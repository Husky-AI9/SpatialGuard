{
  "expo": {
    "name": "Pathlight",
    "slug": "spatialguard",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "spatialguard",
    "ios": {
      "bundleIdentifier": "app.spatialguard.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.spatialguard.mobile"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-video"
    ],
    "icon": "./assets/icon.png"
  }
}
